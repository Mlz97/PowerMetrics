# Copy to deploy/.env and fill in. Never commit deploy/.env.

# Public domain; its DNS A/AAAA record must point at this VPS so Caddy can get the HTTPS certificate
PWR_DOMAIN=pwrmetrics.example.com

POSTGRES_DB=pwrmetrics
POSTGRES_USER=pwrmetrics
POSTGRES_PASSWORD=change-me

# Per-IP limits (429 with Retry-After)
PWR_RATE_UPLOAD_PER_HOUR=5
PWR_RATE_UPLOAD_PER_DAY=20

# Analyses running at once and queued before uploads answer 503; CPUs the analysis container may use
PWR_ANALYSIS_CONCURRENCY=2
PWR_ANALYSIS_QUEUE_CAPACITY=10
PWR_ANALYSIS_CPUS=2

# Longest video accepted, and days before video files are deleted (metrics are kept)
PWR_MAX_VIDEO_SECONDS=60
PWR_RETENTION_DAYS=7
